android_app {
    name: "SHIFT-SettingsProvider",

    overrides: ["LineageSettingsProvider"],

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    privileged: true,
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "org.lineageos.platform.internal",
    ],

    required: [
        "privapp_allowlist_eco.shift.settingsstorage",
    ],

    aaptflags: [
        "--rename-manifest-package",
        "eco.shift.settingsstorage",
    ],
}

prebuilt_etc {
    name: "privapp_allowlist_eco.shift.settingsstorage",
    sub_dir: "permissions",
    src: "privapp_allowlist_eco.shift.settingsstorage.xml",
    filename_from_src: true,
    system_ext_specific: true,
}
